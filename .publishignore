# .publishignore — dev-only paths to keep OUT of the release branch (main).
#
# Used by publish.sh as `rsync --exclude-from`. Patterns are relative to each published path
# (PUBLISH_PATHS in publish.sh: doolyprof/, docker/, doolysim/) and use rsync filter syntax,
# which is close to .gitignore:
#   - trailing slash matches directories:      scratch/
#   - leading slash anchors to the path root:  /tools/foo.py
#   - glob:                                    *_wip.py
#
# Dev-only files at the repository root (analyze_overlap.py, configs/, notes/, ...) are outside
# the published paths and never copied. List here only dev-only files INSIDE a published path.
# A pattern applies in every published path; the ones below exist only in doolysim/.

# doolysim/: plotting, validation and comparison scripts (internal dev tooling)
/benchmark/run_comparison.py
/benchmark/run_streaming_comparison.py
/tools/plot_comparison.py
/tools/plot_configs_cdf.py
/tools/plot_prefill_bars.py
/tools/plot_throughput_bars.py
/tools/plot_validation.py
/tools/plot_validation_chess.py
/tools/run_validation_pipeline.py
/tools/trace_parser.py
/tools/validate_predictions.py

# editor/backup copies are never published
*.bak
